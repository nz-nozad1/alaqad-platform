
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  font-family: Arial, Tahoma, sans-serif;
  color: #050505;
  background: #f7f9fc;
}

body {
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 10%, rgba(30, 64, 175, 0.06), transparent 28%),
    radial-gradient(circle at 90% 20%, rgba(220, 38, 38, 0.05), transparent 25%),
    #f7f9fc;
}

button {
  font-family: inherit;
  border: 0;
}

.home-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* =========================
   GOLD QUOTE
========================= */

.quote-bar {
  width: min(1100px, 90%);
  margin: 18px auto 0;
  padding: 13px 20px;
  text-align: center;
  border-radius: 15px;
  background: linear-gradient(
    90deg,
    #fff8dc,
    #f5d77a,
    #fff8dc
  );
  border: 1px solid rgba(184, 134, 11, 0.25);
  box-shadow:
    0 5px 18px rgba(184, 134, 11, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.quote-bar span {
  color: #9a6b00;
  font-size: 14px;
  font-weight: 900;
  letter-spacing: 0.2px;
}

/* =========================
   NAVBAR
========================= */

.navbar {
  width: 100%;
  min-height: 82px;
  padding: 15px 5%;
  display: flex;
  align-items: center;
  gap: 20px;
  background: rgba(255, 255, 255, 0.93);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.8);
  position: sticky;
  top: 0;
  z-index: 20;
}

/* =========================
   MENU BUTTON
========================= */

.menu-button {
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  border-radius: 14px;
  background: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  box-shadow:
    5px 5px 14px rgba(15, 23, 42, 0.08),
    -4px -4px 12px rgba(255, 255, 255, 0.95);
}

.menu-button span {
  width: 20px;
  height: 2px;
  border-radius: 10px;
  background: #050505;
}

/* =========================
   BRAND
========================= */

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-title {
  font-size: 19px;
  font-weight: 900;
  color: #050505;
}

.brand-subtitle {
  margin-top: 3px;
  color: #202020;
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 800;
}

/* =========================
   BOOK LOGO
========================= */

.book-logo {
  width: 55px;
  height: 52px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.book {
  position: absolute;
  width: 23px;
  height: 39px;
  top: 6px;
  border-radius: 4px 7px 7px 3px;
  box-shadow:
    4px 6px 12px rgba(15, 23, 42, 0.18);
  overflow: hidden;
}

.left-book {
  right: 5px;
  background: linear-gradient(
    145deg,
    #4b0710,
    #8f1022,
    #5b0813
  );
  transform: rotate(-4deg);
}

.right-book {
  left: 5px;
  background: linear-gradient(
    145deg,
    #061a45,
    #123f91,
    #071d4d
  );
  transform: rotate(4deg);
}

.left-book::before,
.right-book::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3px;
  background: rgba(255, 255, 255, 0.35);
}

.left-book::before {
  right: 5px;
}

.right-book::before {
  left: 5px;
}

/* اللمعة المتحركة */

.book::after {
  content: "";
  position: absolute;
  top: -20%;
  left: -80%;
  width: 45%;
  height: 150%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.85),
    transparent
  );
  transform: rotate(25deg);
  animation: bookShine 2.8s linear infinite;
}

.right-book::after {
  animation-delay: 1.1s;
}

@keyframes bookShine {
  0% {
    left: -80%;
  }

  45% {
    left: 140%;
  }

  100% {
    left: 140%;
  }
}

/* =========================
   STUDENT BALANCE
========================= */

.student-balance {
  margin-right: auto;
  min-width: 205px;
  padding: 10px 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid #e7ebf2;
  box-shadow:
    5px 5px 14px rgba(15, 23, 42, 0.07),
    -4px -4px 12px rgba(255, 255, 255, 0.95);
}

.balance-label {
  color: #050505;
  font-size: 12px;
  font-weight: 800;
}

.student-balance strong {
  color: #123f91;
  font-size: 13px;
  font-weight: 900;
}

/* =========================
   HEADER ACTIONS
========================= */

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.contact-btn {
  padding: 11px 18px;
  border-radius: 12px;
  background: white;
  color: #050505;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  box-shadow:
    5px 5px 12px rgba(15, 23, 42, 0.08),
    -4px -4px 10px rgba(255, 255, 255, 0.9);
}

.profile-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #eef2f7;
  font-size: 19px;
  cursor: pointer;
}

/* =========================
   SIDE MENU
========================= */

.side-menu {
  position: fixed;
  top: 0;
  right: 0;
  width: 330px;
  max-width: 85%;
  height: 100vh;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  z-index: 100;
  transform: translateX(105%);
  transition: transform 0.3s ease;
  box-shadow: -15px 0 40px rgba(15, 23, 42, 0.12);
  padding: 25px;
}

.side-menu.open {
  transform: translateX(0);
}

.side-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 25px;
  border-bottom: 1px solid #edf0f5;
}

.side-menu-header h2 {
  color: #050505;
  font-size: 20px;
}

.close-menu {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #f3f5f8;
  color: #050505;
  font-size: 27px;
  cursor: pointer;
}

.side-menu-items {
  padding-top: 25px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.side-menu-items button {
  width: 100%;
  padding: 16px 15px;
  text-align: right;
  border-radius: 13px;
  background: transparent;
  color: #050505;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s ease;
}

.side-menu-items button:hover {
  color: #1255c5;
  background: #eef4ff;
  transform: translateX(-3px);
}

.menu-divider {
  height: 1px;
  background: #edf0f5;
  margin: 15px 0;
}

.menu-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.25);
  backdrop-filter: blur(2px);
  z-index: 90;
}

/* =========================
   WELCOME
========================= */

.welcome {
  text-align: center;
  padding: 65px 20px 45px;
}

.welcome-label {
  display: inline-block;
  padding: 8px 15px;
  border-radius: 30px;
  background: white;
  color: #050505;
  font-size: 13px;
  font-weight: 800;
  box-shadow:
    5px 5px 15px rgba(15, 23, 42, 0.06),
    -5px -5px 15px rgba(255, 255, 255, 0.95);
}

.welcome h1 {
  margin-top: 20px;
  color: #050505;
  font-size: clamp(34px, 6vw, 58px);
  line-height: 1.15;
  font-weight: 900;
}

.welcome h1 span {
  color: #0b4fbe;
  text-shadow:
    0 0 8px rgba(30, 100, 220, 0.18);
}

.welcome p {
  margin-top: 16px;
  color: #202020;
  font-size: 16px;
  font-weight: 600;
}

/* =========================
   DASHBOARD
========================= */

.dashboard-grid {
  width: min(1100px, 88%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.dashboard-card {
  min-height: 205px;
  padding: 25px;
  position: relative;
  text-align: right;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.97);
  color: #050505;
  cursor: pointer;
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow:
    9px 9px 24px rgba(15, 23, 42, 0.08),
    -9px -9px 24px rgba(255, 255, 255, 0.95);
  transition: 0.25s ease;
}

.dashboard-card:hover {
  transform: translateY(-6px);
}

.card-icon {
  width: 58px;
  height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17px;
  background: #f1f4f8;
  font-size: 28px;
}

.card-content {
  margin-top: 22px;
}

.card-content h2 {
  color: #050505;
  font-size: 17px;
  font-weight: 900;
}

.card-content p {
  margin-top: 8px;
  color: #202020;
  font-size: 12px;
  line-height: 1.6;
  font-weight: 600;
}

.card-arrow {
  position: absolute;
  left: 22px;
  bottom: 22px;
  color: #123f91;
  font-size: 18px;
  font-weight: 900;
}

/* =========================
   JAX
========================= */

.jax-card {
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.95), transparent 30%),
    linear-gradient(145deg, #eef3ff, #ffffff);
  border: 1px solid rgba(18, 63, 145, 0.18);
}

.jax-card .card-icon {
  background: #e4ebff;
}

.new-badge {
  position: absolute;
  top: 18px;
  left: 18px;
  padding: 5px 9px;
  border-radius: 7px;
  background: #123f91;
  color: white;
  font-size: 9px;
  font-weight: 900;
}

/* =========================
   FOOTER
========================= */

.footer {
  width: min(1100px, 88%);
  margin: 55px auto 25px;
  padding-top: 22px;
  display: flex;
  justify-content: space-between;
  color: #202020;
  font-size: 11px;
  border-top: 1px solid #e5e9f0;
}

/* =========================
   ADMIN INFO
========================= */

.admin-info {
  width: min(1100px, 88%);
  margin: 15px auto 35px;
  padding: 18px 22px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 45px;
  flex-wrap: wrap;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.85);
  box-shadow:
    7px 7px 18px rgba(15, 23, 42, 0.06),
    -7px -7px 18px rgba(255, 255, 255, 0.95);
}

.admin-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #050505;
  font-size: 13px;
  font-weight: 800;
}

.admin-name-red {
  color: #8f1022;
  font-weight: 900;
  animation: redGlow 1.8s ease-in-out infinite alternate;
}

.admin-name-blue {
  color: #123f91;
  font-weight: 900;
  animation: blueGlow 1.8s ease-in-out infinite alternate;
}

@keyframes redGlow {
  from {
    text-shadow: 0 0 2px rgba(143, 16, 34, 0.15);
  }

  to {
    text-shadow:
      0 0 7px rgba(143, 16, 34, 0.65),
      0 0 15px rgba(143, 16, 34, 0.25);
  }
}

@keyframes blueGlow {
  from {
    text-shadow: 0 0 2px rgba(18, 63, 145, 0.15);
  }

  to {
    text-shadow:
      0 0 7px rgba(18, 63, 145, 0.65),
      0 0 15px rgba(18, 63, 145, 0.25);
  }
}

/* =========================
   TABLET
========================= */

@media (max-width: 900px) {
  .dashboard-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .student-balance {
    min-width: 180px;
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {
  .navbar {
    min-height: 70px;
    padding: 12px 4%;
    gap: 9px;
  }

  .menu-button {
    width: 42px;
    height: 42px;
  }

  .brand {
    gap: 7px;
  }

  .book-logo {
    width: 42px;
    height: 42px;
  }

  .book {
    width: 18px;
    height: 31px;
  }

  .brand-title {
    font-size: 15px;
  }

  .brand-subtitle {
    font-size: 7px;
  }

  .student-balance {
    display: flex;
    min-width: auto;
    padding: 8px 10px;
  }

  .balance-label {
    display: none;
  }

  .student-balance strong {
    font-size: 11px;
  }

  .contact-btn {
    display: none;
  }

  .profile-btn {
    width: 40px;
    height: 40px;
  }

  .quote-bar {
    width: 94%;
    margin-top: 12px;
    padding: 11px 10px;
  }

  .quote-bar span {
    font-size: 11px;
  }

  .welcome {
    padding: 45px 15px 35px;
  }

  .welcome h1 {
    font-size: 34px;
  }

  .welcome p {
    font-size: 14px;
  }

  .dashboard-grid {
    width: 92%;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .dashboard-card {
    min-height: 175px;
    padding: 17px;
    border-radius: 20px;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    font-size: 23px;
  }

  .card-content {
    margin-top: 17px;
  }

  .card-content h2 {
    font-size: 14px;
  }

  .card-content p {
    font-size: 10px;
  }

  .admin-info {
    width: 92%;
    gap: 15px;
    flex-direction: column;
    align-items: stretch;
    margin-top: 30px;
  }

  .admin-item {
    justify-content: center;
    font-size: 11px;
  }

  .footer {
    width: 92%;
    gap: 10px;
    flex-direction: column;
    text-align: center;
  }
}
